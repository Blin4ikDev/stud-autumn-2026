[sub_resource type="GDScript" id="GDScript_jhc1u"]
script/source = "extends Node2D

@onready var actor: Actor = $Actor
@onready var puppet: Puppet = $DemoPuppet
@onready var desktop: Windows10Desktop = $\"Windows-10-desktop\"

func _ready():
	scene()

func scene():
	await actor.trigger_action
	
	print(\"Moving Niko to Documents\")
	
	var desktop_icons = desktop.get_desktop_icons()
	var documents_idx = desktop_icons.find_custom(func(icon): return icon[\"name\"] == \"Documents\")
	var documents = desktop_icons[documents_idx]
	
	puppet.act(Puppet.MoveAction.new(documents[\"center\"], 100))
	
	await puppet.action_done
	
	await actor.trigger_action
	
	print(\"Niko tries to open Documents folder!\")
	
	puppet.act(Puppet.JumpAction.new(3))
	
	await puppet.action_done
	
	var explorer = desktop.open_folder(documents[\"path\"])
	
	await actor.trigger_action
	
	var close_button_position = explorer.get_window_button_position(\"close\")
	puppet.act(Puppet.MoveAction.new(close_button_position, 100))
	
	await puppet.action_done
	await actor.trigger_action
	
	puppet.act(Puppet.JumpAction.new(3))
	
	await puppet.action_done
	
	desktop.close_window(explorer)
	
	print(\"Scene done!\")
"

