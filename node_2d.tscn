[sub_resource type="GDScript" id="GDScript_0tef2"]
script/source = "extends CharacterBody2D

@export var actor: Actor

@onready var sprite = $AnimatedSprite2D

func _ready():
	if self.actor == null:
		self.actor = $\"../Actor1\"
	
	sprite.play(\"default\")
	self.actor.trigger_action.connect(self.action)
func _exit_tree() -> void:
	self.actor.trigger_action.disconnect(self.action)

func action():
	self.position.x += 100.0

func _physics_process(_delta: float) -> void:
	if abs(self.actor.x_velocity) < 0.1:
		sprite.animation = \"default\"
	elif sign(self.actor.x_velocity) == 1:
		sprite.animation = \"walk_right\"
	elif sign(self.actor.x_velocity) == -1:
		sprite.animation = \"walk_left\"
	
	self.velocity.x = self.actor.x_velocity * 10.0
	self.move_and_slide()
"

